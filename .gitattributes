# Normalize all text files
* text=auto

# Force LF for scripts and build-critical files
*.sh text eol=lf
*.zig text eol=lf
*.swift text eol=lf
*.h text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.plist text eol=lf

# CI / project config
.github/**/* text eol=lf
ios-app/project.yml text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Archives
*.zip binary
*.tar binary
*.tgz binary
*.gz binary
*.7z binary

# Compiled artifacts
*.so binary
*.dll binary
*.exe binary
*.a binary
