<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>SlowClaw</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string></string>
    </dict>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSMicrophoneUsageDescription</key>
    <string>SlowClaw needs microphone access when you record audio journal entries.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>SlowClaw uses on-device speech recognition to transcribe your audio journal entries.</string>
    <!-- Background audio: lets a recording in progress survive screen lock
         and backgrounding (long audio journals). Pairs with the .playAndRecord
         AVAudioSession category in AudioRecorder.swift. No entitlement file
         is required for the `audio` background mode. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <!-- Permitted background task identifiers. The transcription task lets iOS
         resume on-device transcription of an audio journal that was auto-saved
         before its transcript landed, even after the app was killed. Best-effort
         (OS-gated). Registered in ShareURLDelegate at launch. -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.slowclaw.app.transcription</string>
    </array>
    <!-- ATS is on by default (no NSAllowsArbitraryLoads). The only legacy
         plain-HTTP feed in the catalog is www.aaronsw.com (Paul Graham essays
         RSS), so it gets the sole insecure-load exception. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSExceptionDomains</key>
        <dict>
            <key>www.aaronsw.com</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <!-- UIFileSharingEnabled is intentionally absent (defaults to NO):
         Documents contains private journals, audio, and local models, and
         export already happens explicitly through ShareLink. -->
    <!-- SlowClaw COPIES shared audio into its own Documents/Inbox (see
         VoiceMemoImporter.copyAudio); it never edits the source file in place.
         Declaring in-place support here made iOS take the open-in-place route
         for Voice Memos shares, which stalls at the share sheet's "Preparing"
         spinner and then silently dismisses without launching the app.
         Copy-style import is what we want, so declare NO. -->
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <false/>
    <!-- Declare SlowClaw as a handler for audio files so iOS shows it in the
         share sheet ("Copy to SlowClaw") from Voice Memos / Files. Alternate
         rank keeps Voice Memos/Files as the default and SlowClaw as an option.
         Mirrors web/src-tauri/Info.ios.plist CFBundleDocumentTypes. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Audio Recording</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.audio</string>
                <string>public.mpeg4-audio</string>
                <string>public.mp3</string>
                <string>com.apple.m4a-audio</string>
                <!-- com.apple.protected-mpeg-4-audio intentionally omitted: the
                     runtime importer does not support DRM-protected audio. -->
            </array>
        </dict>
    </array>
</dict>
</plist>
